{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/((?!.*\\.[A-Za-z0-9]+$).*)",
      "has": [{ "type": "host", "value": "fintrack-seven-delta.vercel.app" }],
      "destination": "https://www.rindecol.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "rindecol.online" }],
      "destination": "https://www.rindecol.online/$1",
      "permanent": true
    },
    {
      "source": "/((?!.*\\.[A-Za-z0-9]+$).*)",
      "has": [{ "type": "host", "value": "fintrackcol.online" }],
      "destination": "https://www.rindecol.online/$1",
      "permanent": true
    },
    {
      "source": "/((?!.*\\.[A-Za-z0-9]+$).*)",
      "has": [{ "type": "host", "value": "www.fintrackcol.online" }],
      "destination": "https://www.rindecol.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/push-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
